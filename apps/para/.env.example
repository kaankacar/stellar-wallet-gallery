# Para API key — create a free project at https://developer.getpara.com and
# copy the API key from the dashboard. Free developer keys are BETA keys
# (prefixed BETA_); switch to a PROD_ key only for production traffic.
VITE_PARA_API_KEY=

# Optional. One of BETA | SANDBOX | PROD | DEV. Defaults to BETA.
# Modern keys encode their environment in the key prefix (BETA_/PROD_);
# only legacy keys strictly need this set.
VITE_PARA_ENVIRONMENT=BETA

# OPTIONAL — the swap card is keyless (it talks to the Soroswap router
# contract directly). A key (free: api.soroswap.finance/register) is only
# needed for the API-based maintenance scripts in packages/shared/scripts
# (faucet minting, pool seeding after a testnet reset).
VITE_SOROSWAP_API_KEY=
