# Smart Account Kit gallery app — optional overrides.
#
# NO ENV IS REQUIRED: every value below has a public, documented testnet
# default baked into src/config.ts (from the kit repo's Protocol 27 deployment
# manifest, docs/deployments-protocol-27-2026-07-09.md, and demo/.env.example).
# Copy this file to .env only if you want to point at your own infrastructure.

# Stellar testnet endpoints
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Smart account WASM hash uploaded to testnet (each wallet deploys its own instance)
VITE_ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a

# Deployed WebAuthn (passkey / secp256r1) verifier contract on testnet
VITE_WEBAUTHN_VERIFIER_ADDRESS=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F

# Native XLM Stellar Asset Contract (SAC) on testnet
VITE_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# OpenZeppelin Relayer proxy for fee-sponsored (gasless) transactions.
# Defaults to the deployed public testnet proxy, so the demo is sponsored out
# of the box. Set it to "" to disable — but the kit's shared default deployer
# is sign-only, so without a relayer, wallet deployment and passkey transfers
# have no fee source and will fail.
VITE_RELAYER_URL=https://smart-account-relayer-proxy.sdf-ecosystem.workers.dev
