# app-passkey-kit — every value here is OPTIONAL and PUBLIC. The app runs with
# no .env at all: submission is fee-sponsored through OpenZeppelin Relayer
# Channels' managed TESTNET endpoint, whose API keys are minted keylessly at
# runtime (GET {VITE_RELAYER_URL}/gen — the same mechanism passkey-kit's own
# relayer-proxy worker uses). There are no secrets anywhere in this app.

# Channels-compatible relayer base URL (default shown). Override only to point
# at a self-hosted OZ Relayer with the channels plugin.
# VITE_RELAYER_URL="https://channels.openzeppelin.com/testnet"

# Pre-provisioned Channels API key. Leave unset to mint a throwaway testnet
# key at runtime via /gen (recommended for the demo).
# VITE_RELAYER_API_KEY=""

# Smart-wallet WASM hash used to deploy new wallets. Default is the canonical
# testnet v1 hash from the passkey-kit repo's hash manifest
# (docs/deployments-testnet-2026-07-11.md, re-pinned 2026-07-13).
# VITE_WALLET_WASM_HASH="fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0"
