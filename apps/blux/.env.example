# Blux app id — sign in at https://dashboard.blux.cc, create an app, copy its id.
# Blux validates the appId against its API; login/signing refuse to run with an
# invalid one, so a real dashboard app id is required.
VITE_BLUX_APP_ID=

# Soroswap aggregator API key for the swap demo (free): register at
# https://api.soroswap.finance/register, then generate a key on /login.
# Bearer secret — in this public demo it is baked into the client bundle
# (testnet-only account; rotate/revoke anytime on the Soroswap login page).
VITE_SOROSWAP_API_KEY=
